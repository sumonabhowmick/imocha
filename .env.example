# Copy this file to .env and fill in real values. Never commit .env.

APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace_with_a_secure_random_secret
APP_TIMEZONE=Asia/Kolkata
# Address students use to reach this server (used for email links). Use https in production.
PUBLIC_BASE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:8501
API_BASE_URL=http://localhost:8000

# Application database (create it first: CREATE DATABASE assessflow_ai;).
# URL-encode special characters in the password, e.g. @ -> %40, # -> %23.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/assessflow_ai
# Separate database used only by the automated tests (it is wiped during tests).
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/assessflow_test

# OpenAI (feedback generation and optional AI-assisted text grading)
OPENAI_API_KEY=
# A model your OpenAI account can use that supports JSON output, e.g. gpt-4o-mini or a newer one.
OPENAI_MODEL=
AI_TEXT_GRADING_ENABLED=false

# Email: "smtp" sends real email. "outbox" (development only) saves .eml files to EMAIL_OUTBOX_DIR.
EMAIL_BACKEND=smtp
EMAIL_OUTBOX_DIR=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# true = implicit TLS (usually port 465); false = STARTTLS (usually port 587)
SMTP_USE_SSL=false
ADMIN_NOTIFICATION_EMAIL=
SUPPORT_CONTACT=your assessment administrator

INVITATION_TTL_MINUTES=1440
PASSCODE_TTL_MINUTES=10
PASSCODE_MAX_ATTEMPTS=5
PASSCODE_LOCKOUT_MINUTES=15

ASSESSMENT_DEFAULT_DURATION_MINUTES=45
ASSESSMENT_COMPLETION_POLICY=finish_after_window

DEMO_MODE=false
